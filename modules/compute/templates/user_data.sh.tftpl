#!/usr/bin/env bash
# =============================================================================
# EC2 bootstrap -- rendered by Terraform from templates/user_data.sh.tftpl
#
# Hardening notes:
#   * IMDSv2 only. Every metadata call fetches a token first; an IMDSv1-style
#     unauthenticated GET is refused by the instance metadata service because
#     the launch template sets http_tokens = "required".
#   * No secrets are rendered into user_data. user_data is readable by anyone
#     who can reach the metadata service from inside the instance.
# =============================================================================
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y --no-install-recommends nginx

# --- IMDSv2: obtain a session token, then use it as a header -----------------
TOKEN="$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300" || echo "")"

meta() {
  if [ -n "$TOKEN" ]; then
    curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
      "http://169.254.169.254/latest/meta-data/$1" || echo "unavailable"
  else
    echo "unavailable"
  fi
}

INSTANCE_ID="$(meta instance-id)"
AZ="$(meta placement/availability-zone)"
LOCAL_IP="$(meta local-ipv4)"

# --- Listen on the port Terraform was told the app uses ----------------------
cat > /etc/nginx/sites-available/default <<'NGINXEOF'
server {
    listen ${app_port} default_server;
    listen [::]:${app_port} default_server;
    root /var/www/html;
    index index.html;
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    location / {
        try_files $uri $uri/ =404;
    }
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
NGINXEOF

cat > /var/www/html/index.html <<HTMLEOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>${project} - healthy target</title>
<style>
  :root { color-scheme: dark; }
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
         font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
         background:#0b1220; color:#e6edf3; }
  .card { width:min(560px, 92vw); padding:32px; border:1px solid #22304d; border-radius:14px; background:#111a2e; }
  h1 { margin:0 0 4px; font-size:1.6rem; color:#58A6FF; }
  p.sub { margin:0 0 24px; color:#8b98b0; }
  .row { display:flex; justify-content:space-between; gap:16px; padding:10px 0; border-bottom:1px solid #22304d; }
  .row:last-of-type { border-bottom:none; }
  .k { color:#8b98b0; }
  .v { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color:#58A6FF; }
  .ok { display:inline-block; margin-top:20px; padding:6px 14px; border-radius:999px;
        background:rgba(63,185,80,.15); border:1px solid #3fb950; color:#3fb950; font-weight:600; }
</style>
</head>
<body>
  <main class="card">
    <h1>Private tier reached</h1>
    <p class="sub">${project} &middot; request arrived via the Application Load Balancer</p>
    <div class="row"><span class="k">Instance ID</span><span class="v">$INSTANCE_ID</span></div>
    <div class="row"><span class="k">Availability Zone</span><span class="v">$AZ</span></div>
    <div class="row"><span class="k">Private IP</span><span class="v">$LOCAL_IP</span></div>
    <div class="row"><span class="k">Public IP</span><span class="v">none (private subnet)</span></div>
    <div class="row"><span class="k">Metadata</span><span class="v">IMDSv2 token required</span></div>
    <span class="ok">HEALTHY</span>
  </main>
</body>
</html>
HTMLEOF

nginx -t
systemctl enable nginx
systemctl restart nginx
